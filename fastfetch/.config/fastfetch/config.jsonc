{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [

    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐"
    },

    {
      "type": "title",
      "key": "│",
      "format": "{user-name}@{host-name}"
    },

    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤"
    },

    {
      "type": "custom",
      "format": "│ HARDWARE"
    },
    {
      "type": "cpu",
      "key": "│ CPU:",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ GPU:",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ RAM:",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "│ Disk:",
      "format": "{size-used} / {size-total}"
    },

    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤"
    },

    {
      "type": "custom",
      "format": "│ SYSTEM"
    },
    {
      "type": "os",
      "key": "│ OS:",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "│ Kernel:",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "│ Uptime:",
      "format": "{days}d {hours}h {minutes}m"
    },

    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤"
    },

    {
      "type": "custom",
      "format": "│ SOFTWARE"
    },
    {
      "type": "packages",
      "key": "│ Packages:",
      "format": "{all}"
    },
    {
      "type": "wm",
      "key": "│ WM:",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "│ Terminal:",
      "format": "{name}"
    },
    {
      "type": "shell",
      "key": "│ Shell:",
      "format": "{name}"
    },
    {
      "type": "cursor",
      "key": "│ Cursor:",
      "format": "{theme}"
    },
    {
      "type": "font",
      "key": "│ Font:",
      "format": "{name}"
    },
    {
      "type": "locale",
      "key": "│ Locale:",
      "format": "{result}"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘"
    }
  ]
}
